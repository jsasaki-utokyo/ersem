#!/bin/bash
#PJM -L rscgrp=a-batch
#PJM -L vnode=1
#PJM -L vnode-core=16
#PJM -L elapse=00:20:00
#PJM -j
#PJM -X
# jsasaki 2026-11-25: shared pool, 16 cores (two builds of 8 make workers, then up to 5 serial runs at once), 20 min: the
# measured job takes about 4 min; the first submission as node=1 (job 7685318) was not placed. Whole file new on this date.
# Gate of the port of the muse rev52 changes (primary_producer isw_no3red, carbonate_engine_kw) into this repository.
#   pjsub -x BASE_SHA=<ersem commit before the port>,NEW_SHA=<ersem commit with the port>,TAG=<run tag> gate.pjsub
# Builds the FABM 0-D driver (fabm/src/drivers/0d) twice from ONE frozen FABM / GOTM copy, with the ERSEM tree of
# BASE_SHA and of NEW_SHA (git archive, never the working tree), same compiler and flags; runs the ERSEM test case
# testcases/fabm-ersem-15.06-L4-noben-docdyn-iop.yaml on the 0-D aquarium setup of ersem-setups (one year, RK4; the
# benthic 15.06 test cases no longer initialise with this fork: G2 o_deep is not a setting, H1 needs O2o, jobs 7685360,
# 7685384):
#   base_r1, base_r2  : base binary twice (repeatability floor)
#   new_off           : new binary, switch absent (default 0)
#   new_off0          : new binary, isw_no3red: 0 written for P1-P4
#   new_on            : new binary, isw_no3red: 1 for P1-P4
#   step_off, step_on : new binary, Euler, 4 steps of 1800 s, every step written (one-step O2 check), started from the
#                       new_off state at the record where all of P1-P4 take up nitrate, forcing held constant
#   step_ref          : as step_on, started one step later from the same state (the rates of step_on's first step)
# and decides PASS / FAIL with gate_check.py (fail-closed; skill bit-identity-gates). Work and output stay in the
# git-ignored scratch/port52_<TAG>/ of this repository. jsasaki 2026-11-25: new file.
set -uo pipefail
: "${WORK_DIR:?WORK_DIR unset (set it in the login profile; the job needs #PJM -X)}"
: "${BASE_SHA:?BASE_SHA unset}"; : "${NEW_SHA:?NEW_SHA unset}"; : "${TAG:?TAG unset}"
E="$WORK_DIR/Github/ersem"
G="$E/tests/isw_no3red_gate"
S="$E/scratch/port52_$TAG"
PY="$WORK_DIR/mambaforge/envs/xgotm/bin/python"
SETUP="$WORK_DIR/Github/ersem-setups/0d-aquarium"
export OMP_NUM_THREADS=1
die() { echo "GATE FAIL: $*"; exit 1; }
# jsasaki 2026-11-25: review r3 #3: claim the run directory atomically (a second job with the same TAG stops here)
mkdir -p "$(dirname "$S")" || die "mkdir scratch"
mkdir "$S" 2>/dev/null || die "$S exists (use a new TAG; nothing is overwritten)"
#---> jsasaki 2026-11-25: review r2 #1: the base must be a strict ancestor WITHOUT the port, the new tree must contain it
BASE_FULL=$(git -C "$E" rev-parse --verify "$BASE_SHA^{commit}") || die "BASE_SHA is not a commit"
NEW_FULL=$(git -C "$E" rev-parse --verify "$NEW_SHA^{commit}") || die "NEW_SHA is not a commit"
[[ "$BASE_FULL" != "$NEW_FULL" ]] || die "BASE_SHA and NEW_SHA are the same commit"
git -C "$E" merge-base --is-ancestor "$BASE_FULL" "$NEW_FULL" || die "BASE_SHA is not an ancestor of NEW_SHA"
for item in "src/primary_producer.F90:isw_no3red" "src/carbonate_engine.F90:carbonate_engine_kw"; do
  f=${item%%:*}; w=${item##*:}
  # jsasaki 2026-11-25: review r3 #2: each source read must succeed (an unreadable file is not a clean base)
  git -C "$E" show "$BASE_FULL:$f" > "$S/guard_base.F90" || die "cannot read $f at the base"
  git -C "$E" show "$NEW_FULL:$f" > "$S/guard_new.F90" || die "cannot read $f at the new commit"
  nb=$(grep -c "$w" "$S/guard_base.F90"); nn=$(grep -c "$w" "$S/guard_new.F90")
  [[ "$nb" == 0 ]] || die "the base already contains $w ($f)"
  [[ "$nn" =~ ^[1-9][0-9]*$ ]] || die "the new tree lacks $w ($f)"
done
#<--- jsasaki 2026-11-25
mkdir -p "$S/src/fabm" "$S/src/ersem_base" "$S/src/ersem_new" "$S/setup" || die "mkdir"
#---> jsasaki 2026-11-25: review r3 #4: the setup inputs and the checker are copied once; every run uses the copies
cp "$SETUP"/{run.nml,input.yaml,output.yaml,env_nns_annual.dat,wind.dat} "$S/setup/" || die "setup copy"
cp "$G/gate_check.py" "$S/gate_check.py" || die "checker copy"
CHK="$S/gate_check.py"
#<--- jsasaki 2026-11-25

# ---- frozen sources
git -C "$WORK_DIR/Github/fabm" archive HEAD | tar -x -C "$S/src/fabm" || die "fabm archive"
rsync -a --exclude '.git' "$WORK_DIR/Github/gotm/code/" "$S/src/gotm_code/" || die "gotm copy"
# jsasaki 2026-11-25: review r3 #1: the archives use the validated object ids, not the arguments
git -C "$E" archive "$BASE_FULL" | tar -x -C "$S/src/ersem_base" || die "ersem base archive"
git -C "$E" archive "$NEW_FULL" | tar -x -C "$S/src/ersem_new" || die "ersem new archive"
tree_hash() { (cd "$1" && find . -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1); }
{ echo "fabm $(git -C "$WORK_DIR/Github/fabm" rev-parse HEAD) tree $(tree_hash "$S/src/fabm")"
  echo "gotm $(git -C "$WORK_DIR/Github/gotm/code" rev-parse HEAD) (working tree copy) tree $(tree_hash "$S/src/gotm_code")"
  echo "ersem_base $BASE_FULL"; echo "ersem_new $NEW_FULL"   # jsasaki 2026-11-25: review r3 #1
  echo "setup $(git -C "$WORK_DIR/Github/ersem-setups" rev-parse HEAD 2>/dev/null || echo unknown) $SETUP"
  (cd "$S/setup" && sha256sum *) | sed 's/^/  setup copy /'   # jsasaki 2026-11-25: review r3 #4
  echo "  checker copy $(sha256sum "$CHK" | cut -d' ' -f1)"; } > "$S/SNAPSHOT.txt"
cat "$S/SNAPSHOT.txt"

# ---- builds (site layer: GENKAI Intel stack, as fabm/src/drivers/0d/install_ersem_fabm0d_genkai.sh)
# jsasaki 2026-11-25: fabm/src/drivers/0d needs CMake >= 3.22; the system cmake is older: general software lives under
# $HOME/local (owner rule)
CMAKE=""
for c in "$HOME/local/bin/cmake" "$(command -v cmake)"; do
  [[ -x "$c" ]] || continue
  v=$("$c" --version | head -1 | awk '{print $3}')
  if [[ "$(printf '%s\n' 3.22 "$v" | sort -V | head -1)" == 3.22 ]]; then CMAKE="$c"; break; fi
done
[[ -n "$CMAKE" ]] || die "no cmake >= 3.22"
"$CMAKE" --version | head -1
type module >/dev/null 2>&1 || source /usr/share/Modules/init/bash
set +eu; module load intel/2025.1.3 >/dev/null 2>&1; set -u
command -v ifx >/dev/null 2>&1 || die "ifx not on PATH"
NC=/home/app/intel/2024.1/netcdf/4.9.2; NCF=/home/app/intel/2024.1/netcdf-fortran/4.6.1; H5=/home/app/intel/2025.1.3/hdf5/1.14.4
export PATH="$NC/bin:$NCF/bin:$H5/bin:$PATH"
export LD_LIBRARY_PATH="$NCF/lib:$NC/lib:$H5/lib:${LD_LIBRARY_PATH:-}"
build() {   # tag
  local B="$S/build/$1"
  mkdir -p "$B" || return 1
  # jsasaki 2026-11-25: the selected CMake (>= 3.22); 8 make workers per build, the two builds side by side
  "$CMAKE" -S "$S/src/fabm/src/drivers/0d" -B "$B" -DGOTM_BASE="$S/src/gotm_code" -DFABM_ERSEM_BASE="$S/src/ersem_$1" \
    -DCMAKE_Fortran_COMPILER=ifx -DCMAKE_BUILD_TYPE=Release -DFABM_EMBED_VERSION=OFF -DGOTM_EMBED_VERSION=OFF \
    -DNetCDF_ROOT="$NC" -DNETCDF_DIR="$NC" -DNetCDF_FORTRAN_PATH="$NCF" -DHDF5_ROOT="$H5" -DCMAKE_PREFIX_PATH="$NCF" \
    > "$B/cmake.log" 2>&1 || return 1
  "$CMAKE" --build "$B" --target fabm0d -j 8 > "$B/build.log" 2>&1 || return 1
  [[ -x "$B/fabm0d" ]] || return 1
  echo "$1 binary sha256 $(sha256sum "$B/fabm0d" | cut -d' ' -f1)" > "$B/PROVENANCE.txt"
}
build base & pb=$!; build new & pn=$!
wait $pb; rb=$?; wait $pn; rn=$?
for t in base new; do cat "$S/build/$t/PROVENANCE.txt" 2>/dev/null || { echo "build $t failed"; tail -30 "$S/build/$t/build.log"; }; done
(( rb == 0 && rn == 0 )) || die "build"

# ---- runs (each serial, in its own directory): first the five year runs at the same time; after they finish, the step
# state is picked from new_off and the three step runs run at the same time (jsasaki 2026-11-25: review r5 #3)
# jsasaki 2026-11-25: the no-benthos test case (the benthic ones no longer initialise with this fork, jobs 7685360, 7685384)
YAML="$S/src/ersem_base/testcases/fabm-ersem-15.06-L4-noben-docdyn-iop.yaml"
cmp -s "$YAML" "$S/src/ersem_new/testcases/fabm-ersem-15.06-L4-noben-docdyn-iop.yaml" || die "test case differs between the two trees"
mkrun() {   # name binary switch(none|0|1) mode(year|step|stepref)
  local R="$S/runs/$1"
  mkdir -p "$R" || return 1
  cp "$S/setup"/{run.nml,input.yaml,output.yaml,env_nns_annual.dat,wind.dat} "$R/" || return 1   # jsasaki 2026-11-25: review r3 #4
  "$PY" "$CHK" make_yaml "$YAML" "$R/fabm.yaml" "$3" || return 1
  sed -i -e 's/^   time_step: .*/&\n   xtype: double/' "$R/output.yaml" || return 1   # jsasaki 2026-11-25: every variable in double precision
  if [[ "$4" == step || "$4" == stepref ]]; then
    #---> jsasaki 2026-11-25: one Euler step from a state where P1-P4 all take up nitrate (review r1 #1, #2)
    # start state: the new_off year-run state at the record STEP_T where the smallest nitrate uptake of P1-P4 is largest
    # (written into the initialization of fabm.yaml); forcing (PAR, temperature, salinity, wind) held constant at STEP_T.
    # stepref starts one step later from the same state: fabm0d evaluates a step's rates at the time of the step's end
    # (solar geometry), so stepref's record 0 holds exactly the rates of step_on's first step (job 7685499)
    "$PY" "$CHK" set_state "$R/fabm.yaml" "$S/runs/new_off/output.nc" "$STEP_T" || return 1
    local t0="$STEP_T"; [[ "$4" == stepref ]] && t0="$STEP_T1"
    sed -i -e "s/^start=.*/start=\"$t0\"/" -e "s/^stop=.*/stop=\"$STEP_T4\"/" -e 's/^ode_method=.*/ode_method=1/' \
           -e "s/^env_file=.*/env_file='env_const.dat'/" "$R/run.nml" || return 1
    "$PY" "$CHK" make_env "$R/env_nns_annual.dat" "$R/env_const.dat" "$STEP_T" || return 1
    "$PY" "$CHK" make_env "$R/wind.dat" "$R/wind_const.dat" "$STEP_T" || return 1
    sed -i -e 's/^  file: wind.dat/  file: wind_const.dat/' "$R/input.yaml" || return 1
    grep -q 'file: wind_const.dat' "$R/input.yaml" || return 1
    sed -i -e 's/^   time_step: .*/   time_step: 1/' "$R/output.yaml" || return 1
    #<--- jsasaki 2026-11-25
  fi
  echo "binary $S/build/$2/fabm0d $(sha256sum "$S/build/$2/fabm0d" | cut -d' ' -f1); switch $3; mode $4" > "$R/RUNINFO.txt"
  ( cd "$R" && "$S/build/$2/fabm0d" -y fabm.yaml > run.log 2>&1 ); local rc=$?
  echo "rc=$rc" >> "$R/RUNINFO.txt"
  return $rc
}
# jsasaki 2026-11-25: review r1 #1: the runs in two sets (year runs, then the step runs from a year-run state)
runset() {   # names... (each "name binary switch mode"), all at the same time
  local pids=() names=() fail=0 i
  for spec in "$@"; do set -- $spec; mkrun "$@" & pids+=($!); names+=("$1"); done
  for i in "${!pids[@]}"; do
    wait "${pids[$i]}"; local rc=$?
    echo "run ${names[$i]} rc $rc"
    (( rc == 0 )) || { fail=1; tail -20 "$S/runs/${names[$i]}/run.log"; }
  done
  return $fail
}
runset "base_r1 base none year" "base_r2 base none year" "new_off new none year" "new_off0 new 0 year" "new_on new 1 year" \
  || die "a year run failed"
# jsasaki 2026-11-25: the step time is chosen from the finished new_off year run (review r1 #1)
# jsasaki 2026-11-25: review r3 #4: every checker call uses the copy $CHK
read -r STEP_T STEP_T1 STEP_T4 < <("$PY" "$CHK" pick_state "$S/runs/new_off/output.nc") || die "pick_state"
STEP_T="${STEP_T/T/ }"; STEP_T1="${STEP_T1/T/ }"; STEP_T4="${STEP_T4/T/ }"
echo "step start $STEP_T (reference $STEP_T1, stop $STEP_T4)"
[[ -n "$STEP_T" && -n "$STEP_T1" && -n "$STEP_T4" ]] || die "no step time"
runset "step_off new 0 step" "step_on new 1 step" "step_ref new 1 stepref" || die "a step run failed"

# ---- decision
# jsasaki 2026-11-25: review r3 #4: the decision by the copied checker
"$PY" "$CHK" check "$S/runs" > "$S/gate_result.txt" 2>&1; rc=$?
cat "$S/gate_result.txt"
(( rc == 0 )) || die "gate_check exit $rc"
echo "GATE PASS"
